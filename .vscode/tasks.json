{
  "version": "2.0.0",
  "tasks": [
    {
      // The default build task, so F5 recompiles before launching and keeps
      // recompiling while you edit. Reload the dev host window to pick changes up.
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true },
      "label": "npm: watch"
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "group": "build",
      "label": "npm: compile"
    }
  ]
}
